---
import { SITE } from '../data/site';
import { withBase } from '../utils/url';

const { pathname } = Astro.url;

const links = [
  { href: withBase('/writing/'), label: 'Writing' },
  { href: withBase('/categories/'), label: 'Categories' },
  { href: withBase('/now/'), label: 'Now' },
  { href: withBase('/about/'), label: 'About' },
];

function isCurrent(href: string): boolean {
  return pathname === href || (href !== withBase('/') && pathname.startsWith(href));
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase('/')}>{SITE.title}</a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
